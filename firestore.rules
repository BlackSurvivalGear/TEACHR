rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSuperadmin() { return signedIn() && request.auth.token.email == 'admin@lawal.org'; }
    function ownProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return isSuperadmin() || (signedIn() && ownProfile().data.role == 'admin'); }
    function validUsageTool(toolId) { return toolId in ['lesson','worksheet','quiz','differentiate','curriculum','revision','parent']; }
    function validAdjustmentAudit(data) {
      return data.lastAdminAdjustment is map
        && data.lastAdminAdjustment.action in ['add','reset']
        && data.lastAdminAdjustment.amount is int
        && data.lastAdminAdjustment.amount >= 1
        && data.lastAdminAdjustment.amount <= 1000
        && data.lastAdminAdjustment.adminUid == request.auth.uid
        && data.lastAdminAdjustment.adminEmail == request.auth.token.email
        && data.lastAdminAdjustment.reason is string
        && data.lastAdminAdjustment.reason.size() <= 240
        && data.lastAdminAdjustment.at is string;
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.suspended == false
        && request.resource.data.accountStatus == 'active'
        && ((isSuperadmin() && request.resource.data.role == 'superadmin' && request.resource.data.plan == 'pro')
          || (!isSuperadmin() && request.resource.data.role == 'member' && request.resource.data.plan == 'free'));
      allow update: if signedIn() && uid == request.auth.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.plan == resource.data.get('plan', 'free')
        && request.resource.data.suspended == resource.data.get('suspended', false)
        && request.resource.data.accountStatus == resource.data.get('accountStatus', 'active')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','updatedAt','lastSignInAt'])
        || isSuperadmin() && uid != request.auth.uid && resource.data.email != 'admin@lawal.org'
        && request.resource.data.role in ['member','pro','admin'] && request.resource.data.plan in ['free','pro']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','plan','suspended','accountStatus','updatedAt'])
        || isAdmin() && !isSuperadmin() && uid != request.auth.uid && resource.data.role in ['member','pro']
        && request.resource.data.role in ['member','pro'] && request.resource.data.plan in ['free','pro']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','plan','suspended','accountStatus','updatedAt']);
      allow delete: if isSuperadmin() && uid != request.auth.uid && resource.data.email != 'admin@lawal.org'
        || isAdmin() && !isSuperadmin() && uid != request.auth.uid && resource.data.role in ['member','pro'];
      match /usage/{toolId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if isAdmin()
          && validUsageTool(toolId)
          && request.resource.data.keys().hasOnly(['toolId','successfulGenerations','allowance','updatedAt','lastAdminAdjustment'])
          && request.resource.data.toolId == toolId
          && request.resource.data.successfulGenerations == 0
          && request.resource.data.allowance is int
          && request.resource.data.allowance >= 3
          && request.resource.data.allowance <= 1003
          && request.resource.data.updatedAt is timestamp
          && validAdjustmentAudit(request.resource.data);
        allow update: if isAdmin()
          && validUsageTool(toolId)
          && request.resource.data.keys().hasOnly(['toolId','successfulGenerations','allowance','updatedAt','lastAdminAdjustment'])
          && request.resource.data.toolId == resource.data.toolId
          && request.resource.data.toolId == toolId
          && request.resource.data.successfulGenerations == resource.data.successfulGenerations
          && request.resource.data.allowance is int
          && request.resource.data.allowance >= request.resource.data.successfulGenerations
          && (
            request.resource.data.allowance == resource.data.successfulGenerations + 3
            || (request.resource.data.allowance > resource.data.allowance
              && request.resource.data.allowance <= resource.data.allowance + 1000)
          )
          && request.resource.data.updatedAt is timestamp
          && validAdjustmentAudit(request.resource.data);
        allow delete: if false;
      }
      match /savedPlaces/{placeId} { allow read, write: if signedIn() && request.auth.uid == uid; }
      match /interests/{interestId} { allow read, write: if signedIn() && request.auth.uid == uid; }
    }
    match /places/{placeId} { allow read: if true; allow write: if false; }
    match /returns/{returnId} { allow read: if true; allow write: if false; }
    match /groups/{groupId} { allow read: if true; allow write: if false; }
  }
}
